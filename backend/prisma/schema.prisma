datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
  MECHANIC
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum OrderStatus {
  CHECK_IN
  IN_DIAGNOSIS
  WAITING_APPROVAL
  IN_REPAIR
  READY_FOR_PICKUP
  COMPLETED
  CANCELED
}

enum ItemType {
  LABOR
  PART
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BOLETO
  TRANSFER
}

enum FinancialCategory {
  REVENUE_LABOR
  REVENUE_PARTS
  REVENUE_OTHER
  COST_PARTS
  COST_THIRD_PARTY
  EXPENSE_RENT
  EXPENSE_WATER_LIGHT
  EXPENSE_PAYROLL
  EXPENSE_OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

// ---------------------------------------------------------
// MODELO PRINCIPAL (O "Tenant" / A Sala da Oficina)
// ---------------------------------------------------------
model WorkshopSettings {
  id             String   @id @default(uuid())
  name           String   @default("Minha Oficina")
  slogan         String?  @default("Centro Automotivo Especializado")
  document       String? // CNPJ ou CPF da oficina
  phone          String? // WhatsApp / Telefone comercial
  address        String? // Endereço completo para o cabeçalho do PDF
  logoUrl        String? // URL da logo salva no Cloudflare R2 ou Base64
  primaryColor   String   @default("#0f172a") // Cor principal
  secondaryColor String   @default("#1f16a3") // Cor de destaque
  warrantyTerms  String?  @default("Garantia de 90 dias para serviços executados, conforme legislação vigente.")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription   Subscription?

  // Lado inverso das relações Multi-Tenant
  users          User[]
  customers      Customer[]
  vehicles       Vehicle[]
  serviceOrders  ServiceOrder[]
  transactions   FinancialTransaction[]
  suppliers      Supplier[]
  catalogItems   CatalogItem[]
  stockMovements StockMovement[]

  // Dados fiscais e integração DevNota (Multi-Tenant)
  devnotaCompanyUuid String?
  ambienteFiscal     String?  // Se nulo, usa DEVNOTA_ENVIRONMENT do .env ("sandbox" | "homologacao" | "producao")
  naturezaJuridica   String   @default("PJ") // "PJ" | "PF"
  cnae               String?
  codigoIbge         String?
  cep                String?
  logradouro         String?
  numeroEndereco     String?
  bairro             String?
  complemento        String?
  inscricaoMunicipal String?
  inscricaoEstadual  String?
  regimeTributario   String   @default("SIMPLES")
  cscId              String?
  cscHomologacao     String?
  cscProducao        String?

  // Séries e numeração
  serieNfe           Int      @default(1)
  proximoNumeroNfe   Int      @default(1)
  serieNfce          Int      @default(1)
  proximoNumeroNfce  Int      @default(1)
  serieRps           String   @default("1")
  proximoNumeroRps   Int      @default(1)

  // Certificado numeração 
  certificadoVencimento DateTime?
  codigoServicoPadrao   String?   @default("140101")

  fiscalInvoices     FiscalInvoice[]
  inboundInvoices    InboundInvoice[]
}

model FiscalInvoice {
  id                String           @id @default(uuid())
  workshopId        String
  workshop          WorkshopSettings @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  uuidDevnota       String?
  protocolo         Int?
  referenciaExterna String           @unique
  tipo              String           // "NFE" | "NFCE" | "NFSE"
  finalidade        String           @default("NORMAL") // "NORMAL" | "DEVOLUCAO"
  ambiente          String           @default("sandbox")
  status            String           @default("RASCUNHO") // "RASCUNHO" | "PROCESSANDO" | "AUTORIZADA" | "REJEITADA" | "CANCELADA"

  numero            Int?
  serie             String?
  chaveAcesso       String?
  chaveReferenciada String?
  serviceOrderId    String?
  customerId        String?
  supplierName      String?

  xmlBase64         String?
  pdfBase64         String?
  linkPdf           String?
  linkXml           String?
  motivoRejeicao    String?
  cartaCorrecao     String?

  valorTotal        Float            @default(0)
  payloadEnviado    String?
  retornoApi        String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model InboundInvoice {
  id           String           @id @default(uuid())
  workshopId   String
  workshop     WorkshopSettings @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  chaveAcesso  String           @unique
  numero       Int
  serie        String
  dataEmissao  DateTime
  supplierCnpj String
  supplierName String
  xmlContent   String
  valorTotal   Float            @default(0)

  // Vínculo com fornecedor e snapshot dos itens para devolução
  supplierId      String?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  itensJson       String?
  importedToStock Boolean          @default(true)

  createdAt    DateTime         @default(now())
}

// ---------------------------------------------------------
// EQUIPE (Isolada por Oficina)
// ---------------------------------------------------------
model User {
  id         String           @id @default(uuid())
  workshopId String
  workshop   WorkshopSettings @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(MECHANIC)
  permissions    String[] @default([])
  isActive       Boolean  @default(true)
  commissionRate Float    @default(0) // Comissão padrão em % 
  createdAt      DateTime @default(now())

  serviceOrders ServiceOrder[]
  timelineLogs  OrderTimeline[]
  transactions  FinancialTransaction[]
}

// ---------------------------------------------------------
// CLIENTES E VEÍCULOS (Isolados por Oficina)
// ---------------------------------------------------------
model Customer {
  id         String           @id @default(uuid())
  workshopId String
  workshop   WorkshopSettings @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  name      String
  phone     String
  email     String?
  document  String?

  // Endereço fiscal do cliente (obrigatório para NF-e)
  cep            String?
  logradouro     String?
  numeroEndereco String?
  complemento    String?
  bairro         String?
  cidade         String?
  uf             String?
  codigoIbge     String?

  
  createdAt DateTime @default(now())

  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]
}

model Vehicle {
  id         String           @id @default(uuid())
  workshopId String
  workshop   WorkshopSettings @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  plate      String
  brand      String
  model      String
  year       Int
  color      String?
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  serviceOrders ServiceOrder[]

  // Garante que a placa não se repita DENTRO da mesma oficina, mas aceita em oficinas diferentes
  @@unique([plate, workshopId])
}

// ---------------------------------------------------------
// ORDEM DE SERVIÇO (Isolada por Oficina)
// ---------------------------------------------------------
model ServiceOrder {
  id         String           @id @default(uuid())
  workshopId String
  workshop   WorkshopSettings @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  number         Int         @default(autoincrement())
  trackingToken  String      @unique @default(uuid())
  status         OrderStatus @default(CHECK_IN)
  entryDate      DateTime    @default(now())
  exitDate       DateTime?
  currentKm      Int
  fuelLevel      String?
  customerNotes  String?
  mechanicNotes  String?
  technicalNotes String?

  mechanicCommissionRate Float? // Sobrescreve comissão para esta OS
  discount               Float    @default(0)
  totalAmount            Float    @default(0)
  updatedAt              DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  mechanicId String?
  mechanic   User?    @relation(fields: [mechanicId], references: [id])

  items        OrderItem[]
  timeline     OrderTimeline[]
  transactions FinancialTransaction[]
}

model OrderItem {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  type        ItemType @default(PART)
  description String
  quantity    Int      @default(1)
  costPrice   Float    @default(0)
  unitCost    Float    @default(0)
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
}

model OrderTimeline {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  status         OrderStatus
  description    String?
  isPublic       Boolean      @default(true)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  medias OrderMedia[]
}

model OrderMedia {
  id         String        @id @default(uuid())
  timelineId String
  timeline   OrderTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  url        String
  type       String
  createdAt  DateTime      @default(now())
}

// ---------------------------------------------------------
// FINANCEIRO (Isolado por Oficina)
// ---------------------------------------------------------
model FinancialTransaction {
  id         String           @id @default(uuid())
  workshopId String
  workshop   WorkshopSettings @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  type          TransactionType
  category      String
  description   String
  amount        Float
  paymentMethod PaymentMethod   @default(PIX)
  date          DateTime        @default(now())
  createdAt     DateTime        @default(now())

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
}

// ---------------------------------------------------------
// ESTOQUE E FORNECEDORES (Isolados por Oficina)
// ---------------------------------------------------------
model Supplier {
  id         String           @id @default(uuid())
  workshopId String
  workshop   WorkshopSettings @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  email     String?
  document  String?
  rating    Float    @default(5.0)
  createdAt DateTime @default(now())

  // Dados completos vindos do XML da autopeças
  ie              String?
  cep             String?
  logradouro      String?
  numeroEndereco  String?
  bairro          String?
  cidade          String?
  uf              String?
  codigoIbge      String?

  inboundInvoices InboundInvoice[]

  items CatalogItem[]


}

model CatalogItem {
  id         String           @id @default(uuid())
  workshopId String
  workshop   WorkshopSettings @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  type      String // "PART" ou "LABOR"
  code      String? // SKU
  name      String
  costPrice Float   @default(0)
  salePrice Float   @default(0)
  stock     Int     @default(0)
  minStock  Int     @default(0)
  defects   Int     @default(0)

  supplierId String?
  supplier   Supplier?       @relation(fields: [supplierId], references: [id])
  movements  StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dados fiscais para NF-e e vínculo com XML de compra
  ean               String?
  ncm               String?  @default("87089990")
  cest              String?
  cfopPadraoEntrada String?  @default("1102")
  cfopPadraoSaida   String?  @default("5102")
  csosn             String?  @default("102")
  origem            String?  @default("0")
  unidadeMedida     String?  @default("UN")
  codigoFornecedor  String?

  // Garante que o código (SKU) seja único DENTRO da oficina, mas não no sistema inteiro
  @@unique([code, workshopId])
}

model StockMovement {
  id         String           @id @default(uuid())
  workshopId String
  workshop   WorkshopSettings @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  type        String // "IN", "OUT", "DEFECT"
  quantity    Int
  reason      String?
  createdById String
  createdAt   DateTime @default(now())

  catalogItemId  String
  item           CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  serviceOrderId String?
}

// ---------------------------------------------------------
// MÓDULO COMERCIAL / SAAS (PLANOS, ASSINATURAS E ASAAS)
// ---------------------------------------------------------
model Plan {
  id                  String         @id @default(uuid())
  slug                String         @unique // ex: gestao-essencial, fiscal-100, fiscal-300, personalizado
  name                String
  subtitle            String?
  badge               String?        // ex: "Mais Escolhido"
  isPopular           Boolean        @default(false)
  isActive            Boolean        @default(true)
  isCustomContact     Boolean        @default(false) // true = botão leva para WhatsApp
  whatsappNumber      String?        // ex: 5517999999999
  whatsappMessage     String?        // mensagem pré-preenchida do plano personalizado
  sortOrder           Int            @default(0)
  features            String[]       @default([])

  // Precificação (Mensal: PIX/Boleto/Cartão 1x | Anual: PIX/Boleto à vista ou Cartão até 12x com juros inclusos)
  monthlyPrice        Float          @default(0) // ex: 99, 189, 299
  annualCashPrice     Float          @default(0) // total anual à vista (PIX/Boleto)
  annualCardPrice     Float          @default(0) // total anual no cartão em até 12x (juros já inclusos)
  maxInstallments     Int            @default(12)

  // Limites técnicos e liberação de recursos (Entitlements)
  allowFiscalEmission Boolean        @default(false)
  maxMonthlyInvoices  Int            @default(0) // 0, 100, 300...
  maxUsers            Int            @default(5)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  subscriptions       Subscription[]
}

model Subscription {
  id                    String                @id @default(uuid())
  workshopId            String                @unique
  workshop              WorkshopSettings      @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  planId                String?
  plan                  Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)

  status                SubscriptionStatus    @default(TRIAL)
  billingCycle          BillingCycle          @default(MONTHLY)

  trialEndsAt           DateTime
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?

  // Sobrescritas manuais (para clientes do Plano Personalizado ou cortesias via /console)
  customMonthlyInvoices Int?
  customMonthlyPrice    Float?
  manualOverride        Boolean               @default(false)
  adminNotes            String?

  // Referências no gateway Asaas
  asaasCustomerId       String?
  asaasSubscriptionId   String?

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  payments              SubscriptionPayment[]
}

model SubscriptionPayment {
  id              String       @id @default(uuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  asaasPaymentId  String?      @unique
  billingType     String       // PIX, BOLETO, CREDIT_CARD
  billingCycle    BillingCycle @default(MONTHLY)
  installments    Int          @default(1)
  amount          Float
  status          String       @default("PENDING") // PENDING, CONFIRMED, RECEIVED, OVERDUE, REFUNDED, CANCELED

  dueDate         DateTime
  paidAt          DateTime?

  invoiceUrl      String?
  bankSlipUrl     String?
  pixQrCodeBase64 String?
  pixPayload      String?
  webhookPayload  String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}
